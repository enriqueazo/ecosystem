root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml,asmdef}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[*.{ts,mjs}]
indent_size = 2

[*.cs]
indent_size = 4

# Organización de using
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Llaves en línea nueva (estilo .NET / Unity)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Preferencias de lenguaje
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

# Nomenclatura: tipos y miembros públicos en PascalCase
dotnet_naming_symbols.types_and_public_members.applicable_kinds = class, struct, interface, enum, delegate, method, property, event
dotnet_naming_symbols.types_and_public_members.applicable_accessibilities = *
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.types_and_public_members_pascal.symbols = types_and_public_members
dotnet_naming_rule.types_and_public_members_pascal.style = pascal_case
dotnet_naming_rule.types_and_public_members_pascal.severity = suggestion

# Nomenclatura: interfaces con prefijo I
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_rule.interfaces_prefix_i.symbols = interfaces
dotnet_naming_rule.interfaces_prefix_i.style = prefix_i
dotnet_naming_rule.interfaces_prefix_i.severity = suggestion

# Nomenclatura: campos privados en _camelCase
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
