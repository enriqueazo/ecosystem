# Configuración del entorno de desarrollo local (Nakama + PostgreSQL).
#
# 1. Copia este archivo:  cp .env.example .env   (desde deploy/local/)
# 2. Sustituye cada valor "cambia-esto-…" por uno propio. Para generar valores aleatorios:
#      openssl rand -hex 32
# 3. .env NO se versiona (está en .gitignore). No lo compartas ni lo subas a ningún sitio.
#
# Estos valores solo valen para desarrollo local. Nunca los uses en otro entorno.
# Contrato completo: specs/001-base-proyecto-entorno/contracts/local-environment.md

# --- Base de datos ----------------------------------------------------------------------------

# Contraseña del usuario de PostgreSQL que usa Nakama.
# Solo letras y números: forma parte de la dirección de conexión de Nakama.
POSTGRES_PASSWORD=cambiaestolocal

# --- Nakama: claves ---------------------------------------------------------------------------

# Clave de servidor que usarán los clientes para autenticarse (--socket.server_key).
NAKAMA_SERVER_KEY=cambia-esto-server-key

# Clave para llamar a RPC por HTTP desde servidores (--runtime.http_key).
NAKAMA_RUNTIME_HTTP_KEY=cambia-esto-runtime-http-key

# Clave de cifrado de los tokens de sesión (--session.encryption_key).
NAKAMA_SESSION_ENCRYPTION_KEY=cambia-esto-session-encryption-key

# Clave de cifrado de los tokens de refresco (--session.refresh_encryption_key).
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=cambia-esto-session-refresh-encryption-key

# --- Nakama: consola de administración --------------------------------------------------------

# Usuario de la consola (--console.username).
NAKAMA_CONSOLE_USERNAME=cambia-esto-admin

# Contraseña de la consola (--console.password).
NAKAMA_CONSOLE_PASSWORD=cambia-esto-console-password

# Clave de firma de las sesiones de la consola (--console.signing_key).
NAKAMA_CONSOLE_SIGNING_KEY=cambia-esto-console-signing-key

# --- Puertos en el anfitrión (opcionales) -----------------------------------------------------
# Solo se publican en 127.0.0.1. Cámbialos si el puerto ya está ocupado.

# API de cliente de Nakama (por defecto 7350).
NAKAMA_API_PORT=7350

# Consola de administración de Nakama (por defecto 7351).
NAKAMA_CONSOLE_PORT=7351
